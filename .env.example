# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Railway provides this automatically when you add the PostgreSQL plugin —
# just copy the value from your service's Variables tab.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing secret — generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# The server refuses to start in production if this is not set.
SESSION_SECRET=change-me-use-a-long-random-string

# ─── Admin account bootstrap ──────────────────────────────────────────────────
# If no admin user exists in the database, the server will create one
# automatically on first startup using these credentials.
# After the account is created these values are no longer used (the password
# is stored as a bcrypt hash). Change the password inside the app afterwards.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-password

# ─── Email (required for password-reset and GDPR emails) ─────────────────────

# Gmail account used to send emails
GMAIL_USER=your-gmail-account@gmail.com

# Gmail App Password (NOT your normal Gmail password).
# Create one at: https://myaccount.google.com/apppasswords
# Required scope: Mail
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Resend API key (alternative email provider — used if set, Gmail is fallback)
# Get one free at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Runtime ──────────────────────────────────────────────────────────────────

# Always set this to "production" on Railway
NODE_ENV=production

# Port — Railway injects this automatically; do not set it manually.
# PORT=5000

# Public HTTPS URL assigned to the Railway service. Configure this in the EAS
# preview and production environments before building the mobile apps.
EXPO_PUBLIC_API_URL=https://your-railway-domain

# ─── Image storage ───────────────────────────────────────────────────────────
# Images are stored inline in PostgreSQL. The client compresses uploads before
# sending them, and the server rejects oversized files.

# ─── CORS (optional) ──────────────────────────────────────────────────────────
# Comma-separated extra origins to allow (browser-based clients only —
# mobile apps don't send an Origin header).
# ALLOWED_ORIGINS=https://yourdomain.com
