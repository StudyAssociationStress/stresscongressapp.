{
  "name": "my-app",
  "main": "client/index.js",
  "version": "1.0.0",
  "engines": {
  "node": "20.x"
},
  "scripts": {
    "expo:dev": "node scripts/expo-preflight.js && EXPO_UNSTABLE_HEADLESS=1 EXPO_PREVIEW_WEB=1 EXPO_PUBLIC_PREVIEW_WEB=1 EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL:-http://localhost:5000} npx expo start --clear --web --localhost --port 8082",
    "expo:dev:mobile": "EXPO_UNSTABLE_HEADLESS=1 EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL:-http://localhost:5000} node scripts/expo-mobile-dev.js",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "preview:dev": "node scripts/preview-dev.js",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "verify:static-build": "node scripts/verify-static-build.js",
    "eas:preview:android": "npx --yes eas-cli@24.0.0 build --platform android --profile preview",
    "eas:preview:ios": "npx --yes eas-cli@24.0.0 build --platform ios --profile preview",
    "eas:preview": "npx --yes eas-cli@24.0.0 build --platform all --profile preview",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "verify": "npm run check:format && npm run check:types && npm run lint && npm run server:build",
    "verify:ci": "npm run verify && npm run test:e2e",
    "test:e2e": "playwright test",
    "release:reset-history": "tsx scripts/reset-release-history.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
