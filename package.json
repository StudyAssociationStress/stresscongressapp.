    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "babel-preset-expo": "~57.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "expo": "~57.0.23",
